    "test:watch": "vitest",
    "test:bdd": "npm run test:a4"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.1",
    "@supabase/supabase-js": "^2.45.4",
    "@types/node": "^22.9.0",
    "server-only": "^0.0.1",
    "tsx": "^4.23.12",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
