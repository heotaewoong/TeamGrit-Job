{
  "name": "teamgrit-phase1-test-engineering",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "TeamGrit Phase 1 A-3 단위 테스트, A-4 BDD, A-5 요구사항-테스트 하네스",
  "scripts": {
    "test": "npm run test:a3 && npm run test:a4",
    "test:a3": "vitest run task-a3-unit-tests",
